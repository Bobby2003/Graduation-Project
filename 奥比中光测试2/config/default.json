{
  "system": {
    "name": "Real-time 3D Scanner",
    "version": "1.0.0",
    "description": "Windows平台实时3D扫描系统"
  },
  "camera_params": {
    "fx": 475.0,
    "fy": 475.0,
    "cx": 320.0,
    "cy": 240.0,
    "depth_scale": 0.001,
    "min_depth": 0.2,
    "max_depth": 2.5,
    "depth_width": 640,
    "depth_height": 480
  },
  "visual_odometry": {
    "max_features": 1000,
    "min_matches": 20,
    "ransac_threshold": 1.0,
    "min_parallax": 10,
    "scale_factor": 1.0
  },
  "pointcloud": {
    "voxel_size": 0.01,
    "max_points": 100000,
    "downsample_rate": 2,
    "min_points_per_frame": 100
  },
  "scanning": {
    "max_frames": 1000,
    "update_interval": 0.1,
    "vo_update_interval": 0.2,
    "auto_save": true
  },
  "export": {
    "formats": ["colmap", "nerf", "3dgs", "custom"],
    "default_format": "colmap",
    "max_frames_to_export": 100
  }
}